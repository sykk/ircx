target/
# No trailing slash: a symlink named node_modules is not a directory to git,
# and one was committed once because of it.
node_modules
dist/
.vite/
*.log
.DS_Store

# A walk's scripts import each other now, so running one writes a cache beside
# them. Run 30's is committed; nothing needs the next one to be.
__pycache__/

# Agent worktrees created by Claude Code.
.claude/worktrees/

# Claude Code writes this as you approve things, and it is personal to the
# machine rather than to the project.
.claude/settings.local.json
